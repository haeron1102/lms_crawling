{
    "manifest_version" : 3,
    "name" : "KLMS_CRAWLING",
    "version" : "2.3",
    "description" : "to webcrawling klms",
    "icons" : {
        "16" : "images/extension_logo_16.png",
        "32" : "images/extension_logo_32.png",
        "48" : "images/extension_logo_48.png",
        "128" : "images/extension_logo_128.png"
    },

    "permissions": ["activeTab", "scripting", "storage"],

    "host_permissions" : [
        "https://klms.kaist.ac.kr/*"
    ],

    "action" : {
        "default_popup" : "popup/popup.html"
    },

    "content_scripts": [
        {
            "matches":["<all_urls>"],
            "js" : ["content.js"]
        }
    ]
}