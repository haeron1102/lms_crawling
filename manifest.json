{
    "manifest_version" : 3,
    "name" : "LMS_CRAWLING",
    "version" : "1.0",
    "description" : "to webcrawling klms",

    "permissions": ["activeTab", "scripting"],

    "host_permissions" : [
        "https://klms.kaist.ac.kr/*"
    ],

    "action" : {
        "default_popup" : "popup.html"
    },

    "content_scripts": [
        {
            "matches":["https://klms.kaist.ac.kr/*"],
            "js" : ["content.js"]
        }
    ]
}